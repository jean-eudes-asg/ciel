{
  "manifest_version": 3,
  "name": "Ciel for Chrome",
  "version": "0.2.5",
  "description": "Shows websites' notifications in Ciel's island instead of the browser's popups. Talks only to Ciel, on this computer.",
  "key": "",
  "minimum_chrome_version": "111",
  "permissions": [
    "nativeMessaging",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "page.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "relay.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/32.png",
    "32": "icons/32.png",
    "48": "icons/128.png",
    "128": "icons/128.png"
  }
}
